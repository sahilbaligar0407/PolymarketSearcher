# Copy to .env and fill in what you have. Missing credentials degrade a source; they
# never stop the engine from booting in PAPER mode.

MARKETLAB_MODE=PAPER
MARKETLAB_PROFILE=paper

# --- Kalshi (the execution venue) -------------------------------------------------
# Create an API key at kalshi.com; download the RSA private key and point at the file.
# The private key must live outside git. Never paste it into a config file.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# production | demo  -- demo credentials must never be sent to production.
KALSHI_ENVIRONMENT=production

# --- Polymarket -------------------------------------------------------------------
# Global Polymarket is READ-ONLY intelligence for this deployment (US geoblock).
# Polymarket US keys are optional and unused while Kalshi is the only execution venue.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# --- Optional information sources -------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
X_BEARER_TOKEN=
THE_ODDS_API_KEY=
FRED_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# SEC REQUIRES a User-Agent containing a real contact email. Its bot filter returns 403
# for any User-Agent without an '@'. Without this, all SEC ingestion is disabled.
SEC_USER_AGENT=MarketLab research (your-email@example.com)

# --- Local AI ---------------------------------------------------------------------
# auto | ollama | openai_compatible | disabled
LOCAL_LLM_PROVIDER=auto
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# --- Live trading -----------------------------------------------------------------
# Must be exactly YES_I_ACCEPT_REAL_LOSS to arm. Anything else keeps live hard-disabled.
LIVE_TRADING_ENABLED=NO
